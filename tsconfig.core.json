{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": []
  },
  "include": [
    "src/game/runner/types.ts",
    "src/game/runner/constants.ts",
    "src/game/runner/gameState.ts",
    "src/game/runner/updateGame.ts",
    "src/game/runner/input/input.ts",
    "src/game/runner/player/**/*.ts",
    "src/game/runner/obstacles/**/*.ts",
    "src/game/runner/collision/**/*.ts",
    "src/game/runner/scoring/**/*.ts",
    "src/game/runner/difficulty/**/*.ts",
    "src/game/runner/environment/**/*.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
